# Server Configuration
PORT=5000
NODE_ENV=production

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flickersecure_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Redis (for real-time features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# API Keys (for future services)
GOOGLE_MAPS_API_KEY=your_google_maps_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# ==========================================
#         SOLANA BLOCKCHAIN CONFIG
# ==========================================

# Network: "devnet" (free testing) | "mainnet-beta" (real money!)
SOLANA_NETWORK=devnet

# RPC URL - Free public endpoint (rate-limited)
# For production, use paid providers: Helius, QuickNode, Alchemy
SOLANA_RPC_URL=https://api.devnet.solana.com

# Wallet Private Key (Base58 encoded)
# Generate using: GET http://localhost:5000/api/blockchain/generate-wallet
# Then request free SOL: POST http://localhost:5000/api/blockchain/airdrop
SOLANA_WALLET_KEY=
